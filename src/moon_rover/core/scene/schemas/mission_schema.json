{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mission.yaml schema",
  "description": "Validates the top-level structure of mission.yaml for the Moon Rover simulation.",
  "type": "object",
  "required": ["rovers"],
  "additionalProperties": true,
  "properties": {
    "mission": {
      "type": "object",
      "properties": {
        "mission_id":   { "type": "string", "minLength": 1 },
        "name":         { "type": "string" },
        "description":  { "type": "string" }
      }
    },
    "grid": {
      "type": "object",
      "properties": {
        "spacing_m": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "array": {
      "type": "object",
      "required": ["array_id", "operating_band", "commissioning"],
      "properties": {
        "array_id":                 { "type": "string", "minLength": 1 },
        "reference_origin_xyz":     { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
        "placement_tolerance_m":    { "type": "number", "exclusiveMinimum": 0 },
        "tilt_tolerance_deg":       { "type": "number", "exclusiveMinimum": 0 },
        "baseline_tolerance_m":     { "type": "number", "exclusiveMinimum": 0 },
        "operating_band": {
          "type": "object",
          "required": ["center_frequency_hz", "bandwidth_hz"],
          "properties": {
            "center_frequency_hz": { "type": "number", "exclusiveMinimum": 0 },
            "bandwidth_hz":        { "type": "number", "exclusiveMinimum": 0 },
            "polarization":        { "type": "string" }
          }
        },
        "commissioning": {
          "type": "object",
          "required": ["topology"],
          "properties": {
            "topology":            { "enum": ["home_run_umbilical", "trunk_with_taps", "wireless_relay"] },
            "timing_distribution": { "type": "string" },
            "data_transport":      { "type": "string" },
            "power_distribution":  { "type": "string" },
            "require_connector_lock": { "type": "boolean" },
            "require_timing_lock":    { "type": "boolean" },
            "require_data_link":      { "type": "boolean" },
            "require_power_good":     { "type": "boolean" }
          }
        }
      }
    },
    "rovers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rover_id", "rover_profile"],
        "properties": {
          "rover_id":      { "type": "string", "minLength": 1 },
          "rover_profile": { "type": "string", "minLength": 1 },
          "cable_id":      { "type": "string" },
          "grid_position": {
            "type": "array",
            "items": { "type": "integer" },
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    "cable": {
      "type": "object",
      "properties": {
        "cable_id":            { "type": "string" },
        "length_m":            { "type": "number", "exclusiveMinimum": 0 },
        "diameter_mm":         { "type": "number", "exclusiveMinimum": 0 },
        "linear_density_kg_m": { "type": "number", "exclusiveMinimum": 0 },
        "max_tension_n":       { "type": "number", "exclusiveMinimum": 0 },
        "power": {
          "type": "object",
          "properties": {
            "enabled":             { "type": "boolean" },
            "voltage_dc":          { "type": "number", "exclusiveMinimum": 0 },
            "resistance_per_m_ohms":{ "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "waypoints": {},
    "success_criteria": {
      "type": "object"
    }
  }
}
